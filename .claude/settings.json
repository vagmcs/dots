{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(basename *)",
      "Bash(date *)",
      "Bash(tr *)",
      "Bash(obsidian *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(**/.env*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:catppuccin",
  "voiceEnabled": true
}
