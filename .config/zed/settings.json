{
  "theme": "Catppuccin Mocha",
  "icon_theme": "Catppuccin Mocha",
  "ui_font_family": ".ZedSans",
  "ui_font_size": 18,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 18,
  "buffer_line_height": "comfortable",
  "colorize_brackets": false,
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "show_wrap_guides": false,
  "relative_line_numbers": "disabled",
  "scrollbar": {
    "show": "never"
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_sign_in": true,
    "show_onboarding_banner": false,
    "show_branch_status_icon": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_user_menu": true,
    "show_user_picture": true,
    "show_menus": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": false,
    "show_close_button": "hover"
  },
  "preview_tabs": {
    "enabled": false
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": true
  },
  "status_bar": {
    "show_active_file": false,
    "cursor_position_button": true,
    "line_endings_button": false
  },
  "bottom_dock_layout": "contained",
  "project_panel": {
    "hide_hidden": false,
    "hide_root": false,
    "bold_folder_labels": false,
    "git_status": true,
    "file_icons": true,
    "folder_icons": true,
    "entry_spacing": "standard",
    "hide_gitignore": false,
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left",
    "button": true
  },
  "outline_panel": {
    "dock": "left",
    "file_icons": true
  },
  "terminal": {
    "button": true,
    "font_size": 18
  },
  "git_panel": {
    "status_style": "icon",
    "group_by": "status",
    "collapse_untracked_diff": false,
    "tree_view": false,
    "file_icons": true,
    "dock": "left"
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "which_key": {
    "enabled": true
  },
  "lsp": {
    "markdownlint": {
      "initialization_options": {
        "config": {
          "MD013": false,
          "MD040": false
        }
      }
    }
  },
  "semantic_tokens": "off",
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "button": true,
    "enable_feedback": false,
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6-latest",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "edit_predictions": {
    "provider": "none"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
